{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/effexorxruser/open-it-learning/blob/main/catalog/schema/course.schema.json",
  "title": "Open IT Learning — reviewed free course with an official outcome",
  "description": "Draft structure for a free IT course with source-backed official achievements or benefits (certificates, badges, diplomas, awards, records, vouchers and other issuer-documented perks). JSON validation does not replace semantic review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "provider",
    "official_url",
    "learning",
    "outcomes",
    "evidence",
    "review"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "provider": {
      "type": "string",
      "minLength": 2
    },
    "official_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "category": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "level": {
      "type": [
        "string",
        "null"
      ]
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "duration_hours": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "free",
        "conditions",
        "cost",
        "currency"
      ],
      "properties": {
        "free": {
          "const": true
        },
        "conditions": {
          "type": "string",
          "minLength": 5
        },
        "cost": {
          "const": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/outcome"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewed_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified_free_outcome",
            "verified_paid_outcome"
          ]
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "recheck_after": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "type",
        "name",
        "issuer",
        "obtainable",
        "requirements",
        "cost_to_obtain",
        "currency",
        "official_evidence_url",
        "individual_verification_url"
      ],
      "properties": {
        "kind": {
          "enum": [
            "recognition",
            "benefit"
          ]
        },
        "type": {
          "enum": [
            "completion_certificate",
            "professional_certificate",
            "digital_badge",
            "diploma",
            "award",
            "participation_record",
            "exam_voucher",
            "training_credit",
            "other_official_recognition",
            "other_official_benefit"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "issuer": {
          "type": "string",
          "minLength": 2
        },
        "obtainable": {
          "const": true
        },
        "requirements": {
          "type": "string",
          "minLength": 8
        },
        "cost_to_obtain": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "official_evidence_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "individual_verification_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "exam_voucher",
                  "training_credit",
                  "other_official_benefit"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "benefit"
              }
            }
          },
          "else": {
            "properties": {
              "kind": {
                "const": "recognition"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cost_to_obtain": {
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "cost_to_obtain"
            ]
          },
          "then": {
            "properties": {
              "currency": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "source_url",
        "short_quote",
        "checked_at",
        "review_note"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 2
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "short_quote": {
          "type": "string",
          "minLength": 2
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "review_note": {
          "type": "string",
          "minLength": 8
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review": {
            "properties": {
              "status": {
                "const": "verified_free_outcome"
              }
            }
          }
        },
        "required": [
          "review"
        ]
      },
      "then": {
        "properties": {
          "outcomes": {
            "contains": {
              "type": "object",
              "properties": {
                "cost_to_obtain": {
                  "const": 0
                }
              }
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review": {
            "properties": {
              "status": {
                "const": "verified_paid_outcome"
              }
            }
          }
        },
        "required": [
          "review"
        ]
      },
      "then": {
        "properties": {
          "outcomes": {
            "items": {
              "properties": {
                "cost_to_obtain": {
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        }
      }
    }
  ]
}
