{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/effexorxruser/open-it-learning/blob/main/catalog/schema/course.schema.json",
  "title": "Open IT Learning verified certificate course (draft)",
  "description": "Validates the structure of a publicly reviewed free IT course with an officially documented obtainable certificate. Human review of evidence remains mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "provider",
    "official_url",
    "learning",
    "certificate",
    "evidence",
    "review"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "provider": {
      "type": "string",
      "minLength": 2
    },
    "official_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "category": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "level": {
      "type": [
        "string",
        "null"
      ]
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "duration_hours": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "free",
        "conditions",
        "cost",
        "currency"
      ],
      "properties": {
        "free": {
          "const": true
        },
        "conditions": {
          "type": "string",
          "minLength": 2
        },
        "cost": {
          "const": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "type",
        "requirements",
        "cost",
        "currency",
        "official_evidence_url"
      ],
      "properties": {
        "available": {
          "const": true
        },
        "type": {
          "enum": [
            "completion_certificate",
            "professional_certification",
            "other_certificate"
          ]
        },
        "requirements": {
          "type": "string",
          "minLength": 5
        },
        "cost": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "official_evidence_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "evidence": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "source_url",
          "short_quote",
          "checked_at",
          "review_note"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 2
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "short_quote": {
            "type": "string",
            "minLength": 2
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "review_note": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewed_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified_free_certificate",
            "verified_paid_certificate"
          ]
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "recheck_after": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review": {
            "properties": {
              "status": {
                "const": "verified_free_certificate"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "certificate": {
            "properties": {
              "cost": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review": {
            "properties": {
              "status": {
                "const": "verified_paid_certificate"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "certificate": {
            "properties": {
              "cost": {
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    }
  ]
}
